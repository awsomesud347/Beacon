# --- Narration ---
NARRATOR=cloud
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# confirm the exact id via GET /v1/models
NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NARRATOR=local: any OpenAI-compatible server. Brev: scripts/brev_serve.sh on the GPU box,
# port-forwarded to localhost:8001; LOCAL_LLM_API_KEY = the BEACON_LLM_KEY used there.
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=nemotron-nano-4b
LOCAL_LLM_API_KEY=

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# used by scripts/presynth_demo.py
ELEVENLABS_VOICE_ID=
# must equal the secret configured on the ElevenLabs agent
LLM_PROXY_SECRET=
NGROK_DOMAIN=

# --- App ---
DATASET_PATH=data/fixtures/demo_persona.csv
STUB_MODE=0
DEMO_MODE=0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
